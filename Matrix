FROM all_objects
WHERE UPPER(object_name) IN (
  'PO_HEADERS_ALL',
  'PO_VERSIONS',
  'PO_ACTION_HISTORY',
  'PO_LINES_ALL',
  'PO_DISTRIBUTIONS_ALL',
  'FUN_ALL_BUSINESS_UNITS_V',
  'PER_PERSON_NAMES_FV',
  'PER_USERS',
  'HZ_PARTIES',
  'PO_VENDORS',
  'GL_CODE_COMBINATIONS',
  'GL_DAILY_RATES',
  'WFTASK',
  'WFTASKHISTORY',
  'WFCOMMENTS'
);
