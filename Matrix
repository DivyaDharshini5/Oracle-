/* =====================================================================
   DIRECT APPROVER MISSING + HIERARCHY STOP MISSING VALIDATION
   ===================================================================== */

-- DIRECT APPROVER MISSING
SELECT
    act.action_id,
    task.task_key,
    part.participant_key,
    rul.display_rule_name,
    act.action_number,
    act.action_code,
    act.route_using_code,
    act.user_type_code,
    act.worker_id AS person_id,
    rul.rule_id,
    rul.display_rule_name rule,
    (SELECT cond.condition_name
       FROM por_amx_rule_conditions cond
      WHERE cond.rule_id = rul.rule_id
        AND ROWNUM = 1) condition,
    act.action_code action,
    CASE
        WHEN rul.sandbox_flag = 'N' AND act.sandbox_flag = 'N'
        THEN 'Y'
        ELSE 'N'
    END is_active,
    task.task_key task,
    (SELECT stg.display_stage_name
       FROM por_amx_stages stg
      WHERE stg.stage_key = rul.stage_key
        AND ROWNUM = 1) stage,
    part.participant_key participant,
    'DIRECT APPROVER MISSING' issue_type
FROM
    por_amx_actions act,
    por_amx_rules rul,
    por_amx_participants part,
    por_amx_tasks task
WHERE
    task.task_key = 'Document Approval'              -- TARGETING PO APPROVAL TASK
    AND act.rule_id = rul.rule_id
    AND act.action_code = 'APPROVAL REQUIRED'
    AND act.route_using_code = 'SINGLE APPROVER'     -- Find rules routing to a named person
    AND act.user_type_code = 'WORKER'
    AND rul.participant_id = part.participant_id
    AND rul.task_id = task.task_id
    AND rul.sandbox_flag = 'N'                       -- Checking ACTIVE production rules
    AND act.sandbox_flag = 'N'                       -- Checking ACTIVE production rules
    AND act.worker_id IS NOT NULL
    AND NOT EXISTS (
        SELECT 1
        FROM per_all_assignments_m assignments,
             per_all_people_f people
        WHERE people.person_id = assignments.person_id
          AND TRUNC(SYSDATE) BETWEEN people.effective_start_date AND people.effective_end_date
          AND TRUNC(SYSDATE) BETWEEN assignments.effective_start_date AND assignments.effective_end_date
          AND assignments.assignment_type IN ('E', 'C')
          AND assignments.assignment_status_type IN ('ACTIVE', 'SUSPENDED')
          AND assignments.primary_flag = 'Y'
          AND people.person_id = act.worker_id
    )

UNION ALL

-- HIERARCHY STOP MISSING
SELECT
    act.action_id,
    task.task_key,
    part.participant_key,
    rul.display_rule_name,
    act.action_number,
    act.action_code,
    act.route_using_code,
    act.start_with_code,
    act.do_not_route_beyond_id AS person_id,
    rul.rule_id,
    rul.display_rule_name rule,
    (SELECT cond.condition_name
       FROM por_amx_rule_conditions cond
      WHERE cond.rule_id = rul.rule_id
        AND ROWNUM = 1) condition,
    act.action_code action,
    CASE
        WHEN rul.sandbox_flag = 'N' AND act.sandbox_flag = 'N'
        THEN 'Y'
        ELSE 'N'
    END is_active,
    task.task_key task,
    (SELECT stg.display_stage_name
       FROM por_amx_stages stg
      WHERE stg.stage_key = rul.stage_key
        AND ROWNUM = 1) stage,
    part.participant_key participant,
    'HIERARCHY STOP MISSING' issue_type
FROM
    por_amx_actions act,
    por_amx_rules rul,
    por_amx_participants part,
    por_amx_tasks task
WHERE
    task.task_key = 'Document Approval'              -- TARGETING PO APPROVAL TASK
    AND act.rule_id = rul.rule_id
    AND act.action_code = 'APPROVAL REQUIRED'
    AND act.route_using_code IN ('SUPERVISORY HIERARCHY', 'JOB LEVEL')
    AND act.do_not_route_beyond_id IS NOT NULL       -- Find rules with a specific stop
    AND rul.participant_id = part.participant_id
    AND rul.task_id = task.task_id
    AND rul.sandbox_flag = 'N'                       -- Checking ACTIVE production rules
    AND act.sandbox_flag = 'N'                       -- Checking ACTIVE production rules
    AND NOT EXISTS (
        SELECT 1
        FROM per_all_assignments_m assignments,
             per_all_people_f people
        WHERE people.person_id = assignments.person_id
          AND TRUNC(SYSDATE) BETWEEN people.effective_start_date AND people.effective_end_date
          AND TRUNC(SYSDATE) BETWEEN assignments.effective_start_date AND assignments.effective_end_date
          AND assignments.assignment_type IN ('E', 'C')
          AND assignments.assignment_status_type IN ('ACTIVE', 'SUSPENDED')
          AND assignments.primary_flag = 'Y'
          AND people.person_id = act.do_not_route_beyond_id
    );
``
