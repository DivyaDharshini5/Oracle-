CASE
    WHEN poapp.L5_APPROVED_BY = :P_SELECTED_APPROVER THEN poapp.L5_APPROVED_BY
    WHEN poapp.L4_APPROVED_BY = :P_SELECTED_APPROVER THEN poapp.L4_APPROVED_BY
    WHEN poapp.L3_APPROVED_BY = :P_SELECTED_APPROVER THEN poapp.L3_APPROVED_BY
    WHEN poapp.L2_APPROVED_BY = :P_SELECTED_APPROVER THEN poapp.L2_APPROVED_BY
    WHEN poapp.L1_APPROVED_BY = :P_SELECTED_APPROVER THEN poapp.L1_APPROVED_BY
END AS SELECTED_APPROVER,
CASE
    WHEN poapp.L5_APPROVED_BY = :P_SELECTED_APPROVER THEN poapp.L5_APPROVED_DT
    WHEN poapp.L4_APPROVED_BY = :P_SELECTED_APPROVER THEN poapp.L4_APPROVED_DT
    WHEN poapp.L3_APPROVED_BY = :P_SELECTED_APPROVER THEN poapp.L3_APPROVED_DT
    WHEN poapp.L2_APPROVED_BY = :P_SELECTED_APPROVER THEN poapp.L2_APPROVED_DT
    WHEN poapp.L1_APPROVED_BY = :P_SELECTED_APPROVER THEN poapp.L1_APPROVED_DT
END AS APPROVAL_DATE_BY_SELECTED_APPROVER,
CASE
    WHEN poapp.L5_APPROVED_BY IS NOT NULL THEN poapp.L5_APPROVED_BY
    WHEN poapp.L4_APPROVED_BY IS NOT NULL THEN poapp.L4_APPROVED_BY
    WHEN poapp.L3_APPROVED_BY IS NOT NULL THEN poapp.L3_APPROVED_BY
    WHEN poapp.L2_APPROVED_BY IS NOT NULL THEN poapp.L2_APPROVED_BY
    ELSE NULL
END AS PREVIOUS_APPROVER,
CASE
    WHEN poapp.L5_APPROVED_DT IS NOT NULL THEN poapp.L5_APPROVED_DT
    WHEN poapp.L4_APPROVED_DT IS NOT NULL THEN poapp.L4_APPROVED_DT
    WHEN poapp.L3_APPROVED_DT IS NOT NULL THEN poapp.L3_APPROVED_DT
    WHEN poapp.L2_APPROVED_DT IS NOT NULL THEN poapp.L2_APPROVED_DT
    ELSE NULL
END AS APPROVAL_DATE_BY_PREVIOUS_APPROVER,
(TRUNC(TO_DATE(COALESCE(poapp.L5_APPROVED_DT, poapp.L4_APPROVED_DT, poapp.L3_APPROVED_DT, poapp.L2_APPROVED_DT, poapp.L1_APPROVED_DT),'DD.MM.YYYY'))
 - TRUNC(TO_DATE(COALESCE(poapp.L5_APPROVED_DT, poapp.L4_APPROVED_DT, poapp.L3_APPROVED_DT, poapp.L2_APPROVED_DT),'DD.MM.YYYY'))) AS TOTAL_DAYS_PENDING_FROM_PREVIOUS_APPROVER,
(TRUNC(TO_DATE(COALESCE(poapp.L5_APPROVED_DT, poapp.L4_APPROVED_DT, poapp.L3_APPROVED_DT, poapp.L2_APPROVED_DT, poapp.L1_APPROVED_DT),'DD.MM.YYYY'))
 - TRUNC(POH.SUBMIT_DATE)) AS TOTAL_DAYS_PENDING_FROM_SUBMISSION,
(TRUNC(TO_DATE(COALESCE(poapp.L5_APPROVED_DT, poapp.L4_APPROVED_DT, poapp.L3_APPROVED_DT, poapp.L2_APPROVED_DT, poapp.L1_APPROVED_DT),'DD.MM.YYYY'))
 - TRUNC(POH.SUBMIT_DATE)) AS TOTAL_DAYS_TAKEN_BY_SELECTED_APPROVER
