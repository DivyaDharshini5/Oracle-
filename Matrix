SELECT DISTINCT
    CASE
        WHEN L5_APPROVED_BY IS NOT NULL THEN L5_APPROVED_BY
        WHEN L4_APPROVED_BY IS NOT NULL THEN L4_APPROVED_BY
        WHEN L3_APPROVED_BY IS NOT NULL THEN L3_APPROVED_BY
        WHEN L2_APPROVED_BY IS NOT NULL THEN L2_APPROVED_BY
        WHEN L1_APPROVED_BY IS NOT NULL THEN L1_APPROVED_BY
    END AS display_value,
    CASE
        WHEN L5_APPROVED_BY IS NOT NULL THEN L5_APPROVED_BY
        WHEN L4_APPROVED_BY IS NOT NULL THEN L4_APPROVED_BY
        WHEN L3_APPROVED_BY IS NOT NULL THEN L3_APPROVED_BY
        WHEN L2_APPROVED_BY IS NOT NULL THEN L2_APPROVED_BY
        WHEN L1_APPROVED_BY IS NOT NULL THEN L1_APPROVED_BY
    END AS return_value
FROM PO_APPROVAL
WHERE L1_APPROVED_BY IS NOT NULL
   OR L2_APPROVED_BY IS NOT NULL
   OR L3_APPROVED_BY IS NOT NULL
   OR L4_APPROVED_BY IS NOT NULL
   OR L5_APPROVED_BY IS NOT NULL
ORDER BY display_value;
