SELECT '1. TOTAL ACTIONS' AS STEP_NAME, COUNT(*) AS ROW_COUNT
FROM FUSION.POR_AMX_ACTIONS

UNION ALL

SELECT '2. APPROVAL REQUIRED ACTIONS', COUNT(*)
FROM FUSION.POR_AMX_ACTIONS
WHERE action_code = 'APPROVAL REQUIRED'

UNION ALL

SELECT '3. SINGLE APPROVER ACTIONS', COUNT(*)
FROM FUSION.POR_AMX_ACTIONS
WHERE action_code = 'APPROVAL REQUIRED'
  AND route_using_code = 'SINGLE APPROVER'

UNION ALL

SELECT '4. SUPERVISORY/JOB LEVEL ACTIONS', COUNT(*)
FROM FUSION.POR_AMX_ACTIONS
WHERE action_code = 'APPROVAL REQUIRED'
  AND route_using_code IN ('SUPERVISORY HIERARCHY', 'JOB LEVEL')

UNION ALL

SELECT '5. ACTIVE SANDBOX=N ACTIONS', COUNT(*)
FROM FUSION.POR_AMX_ACTIONS
WHERE sandbox_flag = 'N'

UNION ALL

SELECT '6. ACTIVE SANDBOX=N RULES', COUNT(*)
FROM FUSION.POR_AMX_RULES
WHERE sandbox_flag = 'N'

UNION ALL

SELECT '7. DOCUMENT APPROVAL TASKS', COUNT(*)
FROM FUSION.POR_AMX_TASKS
WHERE task_key = 'Document Approval'

UNION ALL

SELECT '8. WORKERS WITH ACTIVE PRIMARY ASSIGNMENT', COUNT(*)
FROM FUSION.PER_ALL_ASSIGNMENTS_M assignments,
     FUSION.PER_ALL_PEOPLE_F people
WHERE people.person_id = assignments.person_id
  AND TRUNC(SYSDATE) BETWEEN people.effective_start_date AND people.effective_end_date
  AND TRUNC(SYSDATE) BETWEEN assignments.effective_start_date AND assignments.effective_end_date
  AND assignments.assignment_type IN ('E', 'C')
  AND assignments.assignment_status_type IN ('ACTIVE', 'SUSPENDED')
  AND assignments.primary_flag = 'Y';
