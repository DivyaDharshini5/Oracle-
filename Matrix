SELECT
    act.action_id,
    task.task_key,
    part.participant_key,
    rul.display_rule_name,
    act.action_number,
    act.action_code,
    act.route_using_code,
    act.user_type_code,
    act.worker_id AS person_id,
    rul.rule_id,
    NULL AS condition,
    act.action_code AS action,
    CASE
        WHEN rul.sandbox_flag = 'N' AND act.sandbox_flag = 'N' THEN 'Y'
        ELSE 'N'
    END AS is_active,
    task.task_key AS task,
    NULL AS stage,
    part.participant_key AS participant,
    'DIRECT APPROVER MISSING' AS issue_type
FROM
    FUSION.POR_AMX_ACTIONS act,
    FUSION.POR_AMX_RULES rul,
    FUSION.POR_AMX_PARTICIPANTS part,
    FUSION.POR_AMX_TASKS task
WHERE
    task.task_key = 'Document Approval'
    AND act.rule_id = rul.rule_id
    AND act.action_code = 'APPROVAL REQUIRED'
    AND act.route_using_code = 'SINGLE APPROVER'
    AND act.user_type_code = 'WORKER'
    AND rul.participant_id = part.participant_id
    AND rul.task_id = task.task_id
    AND rul.sandbox_flag = 'N'
    AND act.sandbox_flag = 'N'
    AND act.worker_id IS NOT NULL
    AND NOT EXISTS (
        SELECT 1
        FROM FUSION.PER_ALL_ASSIGNMENTS_M assignments,
             FUSION.PER_ALL_PEOPLE_F people
        WHERE people.person_id = assignments.person_id
          AND TRUNC(SYSDATE) BETWEEN people.effective_start_date AND people.effective_end_date
          AND TRUNC(SYSDATE) BETWEEN assignments.effective_start_date AND assignments.effective_end_date
          AND assignments.assignment_type IN ('E', 'C')
          AND assignments.assignment_status_type IN ('ACTIVE', 'SUSPENDED')
          AND assignments.primary_flag = 'Y'
          AND people.person_id = act.worker_id
    )

UNION ALL

SELECT
    act.action_id,
    task.task_key,
    part.participant_key,
    rul.display_rule_name,
    act.action_number,
    act.action_code,
    act.route_using_code,
    act.start_with_code,
    act.do_not_route_beyond_id AS person_id,
    rul.rule_id,
    NULL AS condition,
    act.action_code AS action,
    CASE
        WHEN rul.sandbox_flag = 'N' AND act.sandbox_flag = 'N' THEN 'Y'
        ELSE 'N'
    END AS is_active,
    task.task_key AS task,
    NULL AS stage,
    part.participant_key AS participant,
    'HIERARCHY STOP MISSING' AS issue_type
FROM
    FUSION.POR_AMX_ACTIONS act,
    FUSION.POR_AMX_RULES rul,
    FUSION.POR_AMX_PARTICIPANTS part,
    FUSION.POR_AMX_TASKS task
WHERE
    task.task_key = 'Document Approval'
    AND act.rule_id = rul.rule_id
    AND act.action_code = 'APPROVAL REQUIRED'
    AND act.route_using_code IN ('SUPERVISORY HIERARCHY', 'JOB LEVEL')
    AND act.do_not_route_beyond_id IS NOT NULL
    AND rul.participant_id = part.participant_id
    AND rul.task_id = task.task_id
    AND rul.sandbox_flag = 'N'
    AND act.sandbox_flag = 'N'
    AND NOT EXISTS (
        SELECT 1
        FROM FUSION.PER_ALL_ASSIGNMENTS_M assignments,
             FUSION.PER_ALL_PEOPLE_F people
        WHERE people.person_id = assignments.person_id
          AND TRUNC(SYSDATE) BETWEEN people.effective_start_date AND people.effective_end_date
          AND TRUNC(SYSDATE) BETWEEN assignments.effective_start_date AND assignments.effective_end_date
          AND assignments.assignment_type IN ('E', 'C')
          AND assignments.assignment_status_type IN ('ACTIVE', 'SUSPENDED')
          AND assignments.primary_flag = 'Y'
          AND people.person_id = act.do_not_route_beyond_id
    )    
