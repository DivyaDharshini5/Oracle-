PRL.ATTRIBUTE4 AS Equipment,
po_det.POCurrency AS PO_Currency,
po_det.UnitCost AS Unit_Price,

CASE 
    WHEN po_det.DESCRIPTION = 'Fixed Price Services'
        THEN po_det.POAMOUNT_ORD
    ELSE 
        (po_det.UnitCost * po_det.POItemQuantity)
END AS PO_Line_Value,

ROUND(
    (
        CASE 
            WHEN po_det.DESCRIPTION = 'Fixed Price Services'
                THEN po_det.POAMOUNT_ORD
            ELSE 
                (po_det.UnitCost * po_det.POItemQuantity)
        END
    )
    *
    NVL((
        SELECT rat.CONVERSION_RATE
        FROM gl_daily_rates rat
        WHERE rat.from_currency = po_det.POCurrency
          AND rat.to_currency = 'USD'
          AND TO_CHAR(rat.conversion_date,'YYYY-MM-DD') =
              TO_CHAR(po_det.PODATEI,'YYYY-MM-DD')
          AND rat.conversion_type = 'Corporate'
          AND ROWNUM = 1
    ),1)
,2) AS PO_Line_Value_USD
