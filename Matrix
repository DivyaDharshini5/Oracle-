poapp.note1,

(
    SELECT pa.poapp_approved_by
    FROM po_approval pa
    WHERE pa.po_header_id = poh.po_header_id
      AND pa.approval_level IN (
            SELECT REGEXP_SUBSTR(:P_SELECTED_LEVELS,'[^,]+',1,LEVEL)
            FROM dual CONNECT BY REGEXP_SUBSTR(:P_SELECTED_LEVELS,'[^,]+',1,LEVEL) IS NOT NULL
        )
    ORDER BY pa.approval_level DESC
    FETCH FIRST 1 ROW ONLY
) AS SELECTED_APPROVER,

(
    SELECT pa.approval_dt
    FROM po_approval pa
    WHERE pa.po_header_id = poh.po_header_id
      AND pa.approval_level IN (
            SELECT REGEXP_SUBSTR(:P_SELECTED_LEVELS,'[^,]+',1,LEVEL)
            FROM dual CONNECT BY REGEXP_SUBSTR(:P_SELECTED_LEVELS,'[^,]+',1,LEVEL) IS NOT NULL
        )
    ORDER BY pa.approval_level DESC
    FETCH FIRST 1 ROW ONLY
) AS APPROVAL_DATE_SELECTED,

(
    SELECT pa.poapp_approved_by
    FROM po_approval pa
    WHERE pa.po_header_id = poh.po_header_id
      AND pa.approval_level IN (
            SELECT REGEXP_SUBSTR(:P_SELECTED_LEVELS,'[^,]+',1,LEVEL)
            FROM dual CONNECT BY REGEXP_SUBSTR(:P_SELECTED_LEVELS,'[^,]+',1,LEVEL) IS NOT NULL
        )
    ORDER BY pa.approval_level DESC
    OFFSET 1 ROW FETCH NEXT 1 ROW ONLY
) AS PREVIOUS_APPROVER,

(
    SELECT pa.approval_dt
    FROM po_approval pa
    WHERE pa.po_header_id = poh.po_header_id
      AND pa.approval_level IN (
            SELECT REGEXP_SUBSTR(:P_SELECTED_LEVELS,'[^,]+',1,LEVEL)
            FROM dual CONNECT BY REGEXP_SUBSTR(:P_SELECTED_LEVELS,'[^,]+',1,LEVEL) IS NOT NULL
        )
    ORDER BY pa.approval_level DESC
    OFFSET 1 ROW FETCH NEXT 1 ROW ONLY
) AS PREVIOUS_APPROVAL_DATE,

(
    TRUNC(
        NVL(
            (SELECT pa.approval_dt
             FROM po_approval pa
             WHERE pa.po_header_id = poh.po_header_id
               AND pa.approval_level IN (
                     SELECT REGEXP_SUBSTR(:P_SELECTED_LEVELS,'[^,]+',1,LEVEL)
                     FROM dual CONNECT BY REGEXP_SUBSTR(:P_SELECTED_LEVELS,'[^,]+',1,LEVEL) IS NOT NULL
                 )
             ORDER BY pa.approval_level DESC
             OFFSET 1 ROW FETCH NEXT 1 ROW ONLY),
            poh.submit_date
        )
    ) -
    TRUNC(
        (SELECT pa.approval_dt
         FROM po_approval pa
         WHERE pa.po_header_id = poh.po_header_id
           AND pa.approval_level IN (
                 SELECT REGEXP_SUBSTR(:P_SELECTED_LEVELS,'[^,]+',1,LEVEL)
                 FROM dual CONNECT BY REGEXP_SUBSTR(:P_SELECTED_LEVELS,'[^,]+',1,LEVEL) IS NOT NULL
             )
         ORDER BY pa.approval_level DESC
         FETCH FIRST 1 ROW ONLY
        )
    )
) AS TOTAL_DAYS_PENDING_FROM_PREVIOUS_APPROVER,

(
    TRUNC(
        (SELECT pa.approval_dt
         FROM po_approval pa
         WHERE pa.po_header_id = poh.po_header_id
           AND pa.approval_level IN (
                 SELECT REGEXP_SUBSTR(:P_SELECTED_LEVELS,'[^,]+',1,LEVEL)
                 FROM dual CONNECT BY REGEXP_SUBSTR(:P_SELECTED_LEVELS,'[^,]+',1,LEVEL) IS NOT NULL
             )
         ORDER BY pa.approval_level DESC
         FETCH FIRST 1 ROW ONLY
        )
    ) - TRUNC(poh.submit_date)
) AS TOTAL_DAYS_PENDING_FROM_SUBMISSION,

(
    TRUNC(
        (SELECT pa.approval_dt
         FROM po_approval pa
         WHERE pa.po_header_id = poh.po_header_id
           AND pa.approval_level IN (
                 SELECT REGEXP_SUBSTR(:P_SELECTED_LEVELS,'[^,]+',1,LEVEL)
                 FROM dual CONNECT BY REGEXP_SUBSTR(:P_SELECTED_LEVELS,'[^,]+',1,LEVEL) IS NOT NULL
             )
         ORDER BY pa.approval_level DESC
         FETCH FIRST 1 ROW ONLY
        )
    ) - TRUNC(poh.submit_date)
) AS TOTAL_DAYS_TAKEN_BY_SELECTED_APPROVER,
