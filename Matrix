SELECT DISTINCT approver AS display_value,
                approver AS return_value
FROM (
    SELECT L1_APPROVED_BY AS approver FROM PO_APPROVAL
    UNION
    SELECT L2_APPROVED_BY FROM PO_APPROVAL
    UNION
    SELECT L3_APPROVED_BY FROM PO_APPROVAL
    UNION
    SELECT L4_APPROVED_BY FROM PO_APPROVAL
    UNION
    SELECT L5_APPROVED_BY FROM PO_APPROVAL
)
WHERE approver IS NOT NULL
ORDER BY approver;
