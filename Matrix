SELECT
    poapp.note1,

    CASE
        WHEN INSTR(',' || :Selection_Approver || ',', ',L5,') > 0 AND poapp.L5_APPROVED_BY IS NOT NULL THEN poapp.L5_APPROVED_BY
        WHEN INSTR(',' || :Selection_Approver || ',', ',L4,') > 0 AND poapp.L4_APPROVED_BY IS NOT NULL THEN poapp.L4_APPROVED_BY
        WHEN INSTR(',' || :Selection_Approver || ',', ',L3,') > 0 AND poapp.L3_APPROVED_BY IS NOT NULL THEN poapp.L3_APPROVED_BY
        WHEN INSTR(',' || :Selection_Approver || ',', ',L2,') > 0 AND poapp.L2_APPROVED_BY IS NOT NULL THEN poapp.L2_APPROVED_BY
        WHEN INSTR(',' || :Selection_Approver || ',', ',L1,') > 0 AND poapp.L1_APPROVED_BY IS NOT NULL THEN poapp.L1_APPROVED_BY
        ELSE NULL
    END AS SELECTED_APPROVER,

    CASE
        WHEN INSTR(',' || :Selection_Approver || ',', ',L5,') > 0 AND poapp.L5_APPROVED_DT IS NOT NULL THEN TRUNC(poapp.L5_APPROVED_DT)
        WHEN INSTR(',' || :Selection_Approver || ',', ',L4,') > 0 AND poapp.L4_APPROVED_DT IS NOT NULL THEN TRUNC(poapp.L4_APPROVED_DT)
        WHEN INSTR(',' || :Selection_Approver || ',', ',L3,') > 0 AND poapp.L3_APPROVED_DT IS NOT NULL THEN TRUNC(poapp.L3_APPROVED_DT)
        WHEN INSTR(',' || :Selection_Approver || ',', ',L2,') > 0 AND poapp.L2_APPROVED_DT IS NOT NULL THEN TRUNC(poapp.L2_APPROVED_DT)
        WHEN INSTR(',' || :Selection_Approver || ',', ',L1,') > 0 AND poapp.L1_APPROVED_DT IS NOT NULL THEN TRUNC(poapp.L1_APPROVED_DT)
        ELSE NULL
    END AS APPROVAL_DATE_BY_SELECTED_APPROVER,

    CASE
        WHEN poapp.L5_APPROVED_BY IS NOT NULL THEN poapp.L4_APPROVED_BY
        WHEN poapp.L4_APPROVED_BY IS NOT NULL THEN poapp.L3_APPROVED_BY
        WHEN poapp.L3_APPROVED_BY IS NOT NULL THEN poapp.L2_APPROVED_BY
        WHEN poapp.L2_APPROVED_BY IS NOT NULL THEN poapp.L1_APPROVED_BY
        ELSE NULL
    END AS PREVIOUS_APPROVER,

    CASE
        WHEN poapp.L5_APPROVED_DT IS NOT NULL THEN TRUNC(poapp.L4_APPROVED_DT)
        WHEN poapp.L4_APPROVED_DT IS NOT NULL THEN TRUNC(poapp.L3_APPROVED_DT)
        WHEN poapp.L3_APPROVED_DT IS NOT NULL THEN TRUNC(poapp.L2_APPROVED_DT)
        WHEN poapp.L2_APPROVED_DT IS NOT NULL THEN TRUNC(poapp.L1_APPROVED_DT)
        ELSE NULL
    END AS APPROVAL_DATE_BY_PREVIOUS_APPROVER,

    TRUNC(POH.SUBMIT_DATE) - TRUNC(COALESCE(poapp.L4_APPROVED_DT, poapp.L3_APPROVED_DT, poapp.L2_APPROVED_DT, poapp.L1_APPROVED_DT)) AS TOTAL_DAYS_PENDING_FROM_PREVIOUS_APPROVER,

    TRUNC(POH.SUBMIT_DATE) - TRUNC(POH.CREATION_DATE) AS TOTAL_DAYS_PENDING_FROM_SUBMISSION,

    TRUNC(POH.SUBMIT_DATE) - TRUNC(
        CASE
            WHEN INSTR(',' || :Selection_Approver || ',', ',L5,') > 0 THEN poapp.L5_APPROVED_DT
            WHEN INSTR(',' || :Selection_Approver || ',', ',L4,') > 0 THEN poapp.L4_APPROVED_DT
            WHEN INSTR(',' || :Selection_Approver || ',', ',L3,') > 0 THEN poapp.L3_APPROVED_DT
            WHEN INSTR(',' || :Selection_Approver || ',', ',L2,') > 0 THEN poapp.L2_APPROVED_DT
            WHEN INSTR(',' || :Selection_Approver || ',', ',L1,') > 0 THEN poapp.L1_APPROVED_DT
            ELSE NULL
        END
    ) AS TOTAL_DAYS_TAKEN_BY_SELECTED_APPROVER
