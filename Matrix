
SELECT DISTINCT
    ppnfv.full_name AS APPROVER
FROM PER_PERSON_NAMES FV PPNFV
LEFT JOIN PO_PENDING popen
    ON ppnfv.PERSON_ID = popen.ASSIGNEES
WHERE ppnfv.full_name IS NOT NULL
UNION
SELECT DISTINCT
    popen.ASSIGNEESDISPLAYNAME AS APPROVER
FROM PO_PENDING popen
WHERE popen.ASSIGNEESDISPLAYNAME IS NOT NULL
UNION
SELECT DISTINCT
    popen.UPDATEDBYDISPLAYNAME AS APPROVER
FROM PO_PENDING popen
WHERE popen.UPDATEDBYDISPLAYNAME IS NOT NULL
ORDER BY APPROVER;
