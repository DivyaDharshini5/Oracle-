WITH actions AS (
    SELECT
        act.rule_id,
        act.action_code AS action,

        MAX(CASE WHEN act.action_number = 1 THEN act.approval_group_name END) AS level1_grp,
        MAX(CASE WHEN act.action_number = 2 THEN act.approval_group_name END) AS level2_grp,
        MAX(CASE WHEN act.action_number = 3 THEN act.approval_group_name END) AS level3_grp,
        MAX(CASE WHEN act.action_number = 4 THEN act.approval_group_name END) AS level4_grp,
        MAX(CASE WHEN act.action_number = 5 THEN act.approval_group_name END) AS level5_grp,
        MAX(CASE WHEN act.action_number = 6 THEN act.approval_group_name END) AS level6_grp,
        MAX(CASE WHEN act.action_number = 7 THEN act.approval_group_name END) AS level7_grp,
        MAX(CASE WHEN act.action_number = 8 THEN act.approval_group_name END) AS level8_grp

    FROM por_amx_actions act
    WHERE act.sandbox_flag = 'Y'
    GROUP BY act.rule_id, act.action_code
),

rules AS (
    SELECT
        rul.rule_id,
        rul.display_rule_name AS rule_name,
        rul.conditions_string,
        rul.active_flag
    FROM por_amx_rules rul
    WHERE rul.sandbox_flag = 'Y'
),

group_users AS (
    SELECT
        g.approval_group_name,
        LISTAGG(u.user_name, ', ')
            WITHIN GROUP (ORDER BY u.user_name) AS users
    FROM por_amx_approval_groups g
    JOIN por_amx_approval_group_members gm
         ON gm.approval_group_id = g.approval_group_id
    JOIN fnd_user u
         ON u.user_id = gm.user_id
    WHERE g.sandbox_flag = 'Y'
    GROUP BY g.approval_group_name
)

SELECT
    r.rule_id,
    r.rule_name,
    r.conditions_string,
    r.active_flag,
    a.action,

    gu1.users AS level1_users,
    gu2.users AS level2_users,
    gu3.users AS level3_users,
    gu4.users AS level4_users,
    gu5.users AS level5_users,
    gu6.users AS level6_users,
    gu7.users AS level7_users,
    gu8.users AS level8_users

FROM actions a
JOIN rules r
  ON r.rule_id = a.rule_id

LEFT JOIN group_users gu1 ON gu1.approval_group_name = a.level1_grp
LEFT JOIN group_users gu2 ON gu2.approval_group_name = a.level2_grp
LEFT JOIN group_users gu3 ON gu3.approval_group_name = a.level3_grp
LEFT JOIN group_users gu4 ON gu4.approval_group_name = a.level4_grp
LEFT JOIN group_users gu5 ON gu5.approval_group_name = a.level5_grp
LEFT JOIN group_users gu6 ON gu6.approval_group_name = a.level6_grp
LEFT JOIN group_users gu7 ON gu7.approval_group_name = a.level7_grp
LEFT JOIN group_users gu8 ON gu8.approval_group_name = a.level8_grp

ORDER BY r.rule_id, a.action;
