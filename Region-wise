WITH actions AS (
    SELECT
        act.rule_id,
        act.action_code,

        MAX(CASE WHEN act.action_number = 1 THEN act.approval_group_name END) AS level1,
        MAX(CASE WHEN act.action_number = 2 THEN act.approval_group_name END) AS level2,
        MAX(CASE WHEN act.action_number = 3 THEN act.approval_group_name END) AS level3,
        MAX(CASE WHEN act.action_number = 4 THEN act.approval_group_name END) AS level4,
        MAX(CASE WHEN act.action_number = 5 THEN act.approval_group_name END) AS level5,
        MAX(CASE WHEN act.action_number = 6 THEN act.approval_group_name END) AS level6,
        MAX(CASE WHEN act.action_number = 7 THEN act.approval_group_name END) AS level7,
        MAX(CASE WHEN act.action_number = 8 THEN act.approval_group_name END) AS level8
    FROM por_amx_actions_vl act
    WHERE act.sandbox_flag = 'Y'
    GROUP BY act.rule_id, act.action_code
)

SELECT
    rul.rule_id,
    rul.display_rule_name AS rule_name,
    actions.action_code,

    actions.level1,
    mem1.member AS level1_member,

    actions.level2,
    mem2.member AS level2_member,

    actions.level3,
    mem3.member AS level3_member,

    actions.level4,
    mem4.member AS level4_member,

    actions.level5,
    mem5.member AS level5_member,

    actions.level6,
    mem6.member AS level6_member,

    actions.level7,
    mem7.member AS level7_member,

    actions.level8,
    mem8.member AS level8_member

FROM por_amx_rules_vl rul
JOIN actions
  ON actions.rule_id = rul.rule_id

/* ===== LEVEL 1 ===== */
LEFT JOIN por_amx_approval_groups_vl ag1
       ON ag1.approval_group_name = actions.level1
LEFT JOIN fa_fusion_soainfra.wfapprovalgroupmembers mem1
       ON mem1.approval_group_id = ag1.approval_group_id

/* ===== LEVEL 2 ===== */
LEFT JOIN por_amx_approval_groups_vl ag2
       ON ag2.approval_group_name = actions.level2
LEFT JOIN fa_fusion_soainfra.wfapprovalgroupmembers mem2
       ON mem2.approval_group_id = ag2.approval_group_id

/* ===== LEVEL 3 ===== */
LEFT JOIN por_amx_approval_groups_vl ag3
       ON ag3.approval_group_name = actions.level3
LEFT JOIN fa_fusion_soainfra.wfapprovalgroupmembers mem3
       ON mem3.approval_group_id = ag3.approval_group_id

/* ===== LEVEL 4 ===== */
LEFT JOIN por_amx_approval_groups_vl ag4
       ON ag4.approval_group_name = actions.level4
LEFT JOIN fa_fusion_soainfra.wfapprovalgroupmembers mem4
       ON mem4.approval_group_id = ag4.approval_group_id

/* ===== LEVEL 5 ===== */
LEFT JOIN por_amx_approval_groups_vl ag5
       ON ag5.approval_group_name = actions.level5
LEFT JOIN fa_fusion_soainfra.wfapprovalgroupmembers mem5
       ON mem5.approval_group_id = ag5.approval_group_id

/* ===== LEVEL 6 ===== */
LEFT JOIN por_amx_approval_groups_vl ag6
       ON ag6.approval_group_name = actions.level6
LEFT JOIN fa_fusion_soainfra.wfapprovalgroupmembers mem6
       ON mem6.approval_group_id = ag6.approval_group_id

/* ===== LEVEL 7 ===== */
LEFT JOIN por_amx_approval_groups_vl ag7
       ON ag7.approval_group_name = actions.level7
LEFT JOIN fa_fusion_soainfra.wfapprovalgroupmembers mem7
       ON mem7.approval_group_id = ag7.approval_group_id

/* ===== LEVEL 8 ===== */
LEFT JOIN por_amx_approval_groups_vl ag8
       ON ag8.approval_group_name = actions.level8
LEFT JOIN fa_fusion_soainfra.wfapprovalgroupmembers mem8
       ON mem8.approval_group_id = ag8.approval_group_id

WHERE rul.sandbox_flag = 'Y';
