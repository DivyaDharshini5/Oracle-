SELECT
    proj.PROJECT_ID,
    proj.SEGMENT1 AS PROJECT_NUMBER,
    proj.NAME AS PROJECT_NAME,
    NVL(proj.PROJECT_TYPE_ID, 'N/A') AS PROJECT_TYPE,
    NVL(proj.CARRYING_OUT_ORGANIZATION_ID, 'N/A') AS PROJECT_ORG_VESSEL,
    reg.LOOKUP_CODE AS REGION,
    TO_CHAR(proj.START_DATE, 'DD-MON-YYYY') AS START_DATE,
    TO_CHAR(proj.COMPLETION_DATE, 'DD-MON-YYYY') AS END_DATE,
    NVL(proj.ATTRIBUTE2, 'No') AS HIDE_IN_NSE,
    proj.PROJECT_STATUS_CODE AS STATUS,
    NVL(bgt.LATEST_BASELINED_AMOUNT, 0) AS BUDGET_LATEST_VERSION,
    NVL(cost.ACTUAL_COST, 0) AS COST,
    NVL(cost.COMMITTED_COST, 0) AS COMMITTED_COST,
    NVL(cost.TOTAL_COST, 0) AS TOTAL_COST,
    NVL(bgt.LATEST_BASELINED_AMOUNT, 0) - NVL(cost.TOTAL_COST, 0) AS AVAILABLE_BUDGET,
    NVL(cost.CAPITALIZED_COST, 0) AS CAPITALIZED_COST
FROM
    PJF_PROJECTS_ALL_VL proj
    LEFT JOIN XXDPW_POML_BU_REGION_MAPPING reg
        ON reg.BUSINESS_UNIT_ID = proj.CARRYING_OUT_ORGANIZATION_ID
       AND reg.ENABLED_FLAG = 'Y'
    LEFT JOIN (
        SELECT
            pb.PROJECT_ID,
            MAX(pb.BASELINE_AMOUNT) AS LATEST_BASELINED_AMOUNT
        FROM PJF_PROJECT_BUDGETS_V pb
        WHERE pb.BUDGET_STATUS_CODE = 'BASELINED'
        GROUP BY pb.PROJECT_ID
    ) bgt
        ON bgt.PROJECT_ID = proj.PROJECT_ID
    LEFT JOIN (
        SELECT
            pc.PROJECT_ID,
            SUM(pc.ACTUAL_COST) AS ACTUAL_COST,
            SUM(pc.COMMITTED_COST) AS COMMITTED_COST,
            SUM(pc.ACTUAL_COST + pc.COMMITTED_COST) AS TOTAL_COST,
            SUM(pc.CAPITALIZED_COST) AS CAPITALIZED_COST
        FROM XXDPW_POML_PROJ_COST_SUMMARY_V pc
        GROUP BY pc.PROJECT_ID
    ) cost
        ON cost.PROJECT_ID = proj.PROJECT_ID
WHERE
    ( :P_REGION IS NULL OR reg.LOOKUP_CODE IN (
        SELECT REGEXP_SUBSTR(:P_REGION, '[^,]+', 1, LEVEL)
        FROM dual
        CONNECT BY REGEXP_SUBSTR(:P_REGION, '[^,]+', 1, LEVEL) IS NOT NULL
    ))
    AND ( :P_PROJECT_TYPE IS NULL 
          OR UPPER(proj.SEGMENT1) LIKE UPPER(:P_PROJECT_TYPE || '%') )
    AND proj.PROJECT_STATUS_CODE NOT IN ('CANCELLED', 'CLOSED')
ORDER BY
    reg.LOOKUP_CODE,
    proj.SEGMENT1;
