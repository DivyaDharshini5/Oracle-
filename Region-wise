WITH actions AS (
    SELECT
        act.rule_id,
        act.action_code,

        MAX(CASE WHEN act.action_number = 1 THEN act.approval_group_name END) AS level1,
        MAX(CASE WHEN act.action_number = 2 THEN act.approval_group_name END) AS level2,
        MAX(CASE WHEN act.action_number = 3 THEN act.approval_group_name END) AS level3,
        MAX(CASE WHEN act.action_number = 4 THEN act.approval_group_name END) AS level4,
        MAX(CASE WHEN act.action_number = 5 THEN act.approval_group_name END) AS level5,
        MAX(CASE WHEN act.action_number = 6 THEN act.approval_group_name END) AS level6,
        MAX(CASE WHEN act.action_number = 7 THEN act.approval_group_name END) AS level7,
        MAX(CASE WHEN act.action_number = 8 THEN act.approval_group_name END) AS level8

    FROM por_amx_actions_vl act
    WHERE act.sandbox_flag = 'Y'
    GROUP BY act.rule_id, act.action_code
)

SELECT
    rul.rule_id,
    rul.display_rule_name AS rule_name,
    actions.action_code,

    actions.level1,
    pg1.member AS level1_member,

    actions.level2,
    pg2.member AS level2_member,

    actions.level3,
    pg3.member AS level3_member,

    actions.level4,
    pg4.member AS level4_member,

    actions.level5,
    pg5.member AS level5_member,

    actions.level6,
    pg6.member AS level6_member,

    actions.level7,
    pg7.member AS level7_member,

    actions.level8,
    pg8.member AS level8_member

FROM por_amx_rules_vl rul
JOIN actions
  ON actions.rule_id = rul.rule_id

/* ===== LEVEL 1 ===== */
LEFT JOIN pox_approval_groups pg1
       ON pg1.approval_group_name = actions.level1

/* ===== LEVEL 2 ===== */
LEFT JOIN pox_approval_groups pg2
       ON pg2.approval_group_name = actions.level2

/* ===== LEVEL 3 ===== */
LEFT JOIN pox_approval_groups pg3
       ON pg3.approval_group_name = actions.level3

/* ===== LEVEL 4 ===== */
LEFT JOIN pox_approval_groups pg4
       ON pg4.approval_group_name = actions.level4

/* ===== LEVEL 5 ===== */
LEFT JOIN pox_approval_groups pg5
       ON pg5.approval_group_name = actions.level5

/* ===== LEVEL 6 ===== */
LEFT JOIN pox_approval_groups pg6
       ON pg6.approval_group_name = actions.level6

/* ===== LEVEL 7 ===== */
LEFT JOIN pox_approval_groups pg7
       ON pg7.approval_group_name = actions.level7

/* ===== LEVEL 8 ===== */
LEFT JOIN pox_approval_groups pg8
       ON pg8.approval_group_name = actions.level8

WHERE rul.sandbox_flag = 'Y';
