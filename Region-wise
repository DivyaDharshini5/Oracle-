WITH actions AS (
    SELECT
        act.action_code                         AS action,
        act.rule_id                             AS rule_id,

        MAX(CASE WHEN act.action_number = 1 THEN act.approval_group_name END) AS level1,
        MAX(CASE WHEN act.action_number = 2 THEN act.approval_group_name END) AS level2,
        MAX(CASE WHEN act.action_number = 3 THEN act.approval_group_name END) AS level3,
        MAX(CASE WHEN act.action_number = 4 THEN act.approval_group_name END) AS level4,
        MAX(CASE WHEN act.action_number = 5 THEN act.approval_group_name END) AS level5,
        MAX(CASE WHEN act.action_number = 6 THEN act.approval_group_name END) AS level6,
        MAX(CASE WHEN act.action_number = 7 THEN act.approval_group_name END) AS level7,
        MAX(CASE WHEN act.action_number = 8 THEN act.approval_group_name END) AS level8,

        MAX(CASE WHEN act.action_number = 1 THEN grp.approval_group_id END) AS level1_group_id,
        MAX(CASE WHEN act.action_number = 2 THEN grp.approval_group_id END) AS level2_group_id,
        MAX(CASE WHEN act.action_number = 3 THEN grp.approval_group_id END) AS level3_group_id,
        MAX(CASE WHEN act.action_number = 4 THEN grp.approval_group_id END) AS level4_group_id,
        MAX(CASE WHEN act.action_number = 5 THEN grp.approval_group_id END) AS level5_group_id,
        MAX(CASE WHEN act.action_number = 6 THEN grp.approval_group_id END) AS level6_group_id,
        MAX(CASE WHEN act.action_number = 7 THEN grp.approval_group_id END) AS level7_group_id,
        MAX(CASE WHEN act.action_number = 8 THEN grp.approval_group_id END) AS level8_group_id

    FROM por_amx_actions_vl act

    LEFT JOIN por_amx_approval_groups_vl grp
           ON grp.approval_group_name = act.approval_group_name
          AND grp.sandbox_flag = 'Y'

    WHERE act.sandbox_flag = 'Y'
    GROUP BY act.action_code, act.rule_id
)

SELECT
    rul.rule_id                                AS rule_id,
    rul.display_rule_name                      AS rule,
    rul.conditions_string                     AS condition,
    rul.active_flag                           AS isactive,

    actions.action                            AS action,

    actions.level1,
    actions.level1_group_id,
    actions.level2,
    actions.level2_group_id,
    actions.level3,
    actions.level3_group_id,
    actions.level4,
    actions.level4_group_id,
    actions.level5,
    actions.level5_group_id,
    actions.level6,
    actions.level6_group_id,
    actions.level7,
    actions.level7_group_id,
    actions.level8,
    actions.level8_group_id,

    task.task_key                             AS task,
    stg.stage_key                             AS stage,
    part.participant_key                      AS participant,
    part.participant_id                       AS participant_id

FROM por_amx_rules_vl rul

JOIN actions
  ON actions.rule_id = rul.rule_id

JOIN por_amx_tasks_vl task
  ON task.task_id = rul.task_id

JOIN por_amx_stages_vl stg
  ON stg.stage_id = rul.stage_id
 AND stg.task_id  = task.task_id

JOIN por_amx_participants_vl part
  ON part.participant_id = rul.participant_id
 AND part.stage_id       = stg.stage_id

WHERE rul.sandbox_flag = 'Y'
