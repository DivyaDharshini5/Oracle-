SELECT
    HOU.NAME AS PO_COMPANY_NAME,
    HOU.NAME AS COMPANY_CODE,  -- Adjust if separate code needed
    PHV.SEGMENT1 AS PO_NUMBER,
    PHV.DOCUMENT_STATUS AS PO_HEADER_STATUS,
    PSV.VENDOR_NAME,
    PSV.VENDOR_NUMBER,
    PHV.CREATED_BY AS PO_CREATED_BY,
    TO_CHAR(PHV.CREATION_DATE,'DD.MM.YYYY') AS PO_CREATION_DATE,
    TO_CHAR(PHV.SUBMIT_DATE,'DD.MM.YYYY') AS SUBMIT_DATE,
    PHV.CURRENCY_CODE,
    PHV.TOTAL_AMOUNT AS PO_AMOUNT,
    PHV.AMOUNT_USD AS PO_USD_AMOUNT,

    -- Final approver from header
    PHV.LAST_APPROVED_BY AS SELECTED_APPROVER,
    TO_CHAR(PHV.LAST_APPROVED_DATE,'DD.MM.YYYY') AS APPROVAL_DATE_BY_SELECTED_APPROVER,
    NULL AS NOTE2,

    -- Previous approver not available without workflow tables
    NULL AS PREVIOUS_APPROVER,
    NULL AS APPROVAL_DATE_BY_PREVIOUS_APPROVER,
    NULL AS NOTE1,

    -- Days calculation
    (TRUNC(SYSDATE) - TRUNC(PHV.LAST_APPROVED_DATE)) AS TOTAL_DAYS_TAKEN_BY_SELECTED_APPROVER,
    NULL AS TOTAL_DAYS_PENDING_FROM_PREVIOUS_APPROVER,
    (TRUNC(SYSDATE) - TRUNC(PHV.SUBMIT_DATE)) AS TOTAL_DAYS_PENDING_FROM_SUBMISSION

FROM
    PO_HEADERS_V PHV
    LEFT JOIN POS_SUPPLIERS_V PSV ON PSV.VENDOR_ID = PHV.VENDOR_ID
    LEFT JOIN HR_ORGANIZATION_UNITS_F_VL HOU ON HOU.ORGANIZATION_ID = PHV.PRC_BU_ID
        AND TRUNC(SYSDATE) BETWEEN HOU.EFFECTIVE_START_DATE AND HOU.EFFECTIVE_END_DATE

WHERE
    TRUNC(PHV.CREATION_DATE) BETWEEN NVL(:P_START_DATE, PHV.CREATION_DATE) AND NVL(:P_END_DATE, PHV.CREATION_DATE)
    AND PHV.DOCUMENT_STATUS = NVL(:P_PO_STATUS, PHV.DOCUMENT_STATUS)
    AND HOU.NAME = NVL(:P_COMPANY_NAME, HOU.NAME)
    AND PSV.VENDOR_NUMBER = NVL(:P_VENDOR_NUMBER, PSV.VENDOR_NUMBER)
    AND PSV.VENDOR_NAME = NVL(:P_VENDOR_NAME, PSV.VENDOR_NAME);
