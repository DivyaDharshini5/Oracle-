SELECT
    FAB.BU_NAME AS PO_COMPANY_NAME,
    FAB.FLEX_VALUE AS COMPANY_CODE,
    POH.SEGMENT1 AS PO_NUMBER,
    POH.DOCUMENT_STATUS AS PO_HEADER_STATUS,
    HP.PARTY_NAME AS VENDOR_NAME,
    POS.SEGMENT1 AS VENDOR_NUMBER,
    POH.CREATED_BY AS PO_CREATED_BY,
    TO_CHAR(POH.CREATION_DATE, 'DD.MM.YYYY') AS PO_CREATION_DATE,
    TO_CHAR(POH.SUBMIT_DATE, 'DD.MM.YYYY') AS SUBMIT_DATE,
    POH.CURRENCY_CODE,
    POL.PO_AMOUNT,
    POL.PO_USD_AMOUNT,

    -- Approval - Previous Approver
    POPEN.PREVIOUS_APPROVER,
    POPEN.APPROVAL_DATE_BY_PREVIOUS_APPROVER,
    POPEN.NOTE1,

    -- Approval - Selected Approver
    POAPP.SELECTED_APPROVER,
    POAPP.APPROVAL_DATE_BY_SELECTED_APPROVER,
    POAPP.NOTE2,

    -- Pending Days
    (TRUNC(SYSDATE) - TRUNC(POPEN.APPROVAL_DATE_BY_PREVIOUS_APPROVER)) AS TOTAL_DAYS_PENDING_FROM_PREVIOUS_APPROVER,
    (TRUNC(SYSDATE) - TRUNC(POAPP.APPROVAL_DATE_BY_SELECTED_APPROVER)) AS TOTAL_DAYS_TAKEN_BY_SELECTED_APPROVER,
    (TRUNC(SYSDATE) - TRUNC(POH.SUBMIT_DATE)) AS TOTAL_DAYS_PENDING_FROM_SUBMISSION

FROM
    PO_HEADERS_ALL POH
    LEFT JOIN PO_LINES_ALL POL ON POL.PO_HEADER_ID = POH.PO_HEADER_ID
    LEFT JOIN PO_APPROVAL_POAPP POAPP ON POAPP.PO_HEADER_ID = POH.PO_HEADER_ID
    LEFT JOIN PO_PENDING_POPEN POPEN ON POPEN.PO_HEADER_ID = POH.PO_HEADER_ID
    LEFT JOIN PO_REJECT_POREJ POREJ ON POREJ.PO_HEADER_ID = POH.PO_HEADER_ID
    LEFT JOIN POS_SUPPLIERS POS ON POS.VENDOR_ID = POH.VENDOR_ID
    LEFT JOIN HZ_PARTIES HP ON HP.PARTY_ID = POS.PARTY_ID
    LEFT JOIN FUN_ALL_BUSINESS_UNITS_V FAB ON FAB.BU_ID = POH.PRC_BU_ID
WHERE
    POH.DOCUMENT_STATUS NOT IN ('CANCELED', 'INCOMPLETE')
    AND TRUNC(POH.CREATION_DATE) BETWEEN :START_DATE_PO AND :END_DATE_PO
    AND NVL(POS.SEGMENT1, '-') = NVL(:P_VENDOR_NUM, NVL(POS.SEGMENT1, '-'))
    AND NVL(HP.PARTY_NAME, '-') = NVL(:P_VENDOR_NAME, NVL(HP.PARTY_NAME, '-'))
    AND FAB.BU_NAME = NVL(:P_COMPANY_NAME, FAB.BU_NAME)
    AND NVL(POH.DOCUMENT_STATUS, '-') = NVL(:P_PO_STATUS, NVL(POH.DOCUMENT_STATUS, '-'));
