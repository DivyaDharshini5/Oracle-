WITH APPROVAL_DATA AS (
    SELECT
        fwa.transaction_id AS PO_HEADER_ID,
        fwa.sequence_num,
        fwa.approver_person_name AS APPROVER,
        fwa.note AS APPROVAL_NOTE,
        fwa.approval_date AS APPROVAL_DATE,
        ROW_NUMBER() OVER (PARTITION BY fwa.transaction_id ORDER BY fwa.sequence_num) AS RANK_NO
    FROM
        FND_WF_APPROVAL_HISTORY_V fwa
    WHERE
        fwa.transaction_type = 'PO'
),

SELECTED_APPROVER AS (
    SELECT
        PO_HEADER_ID,
        APPROVER AS SELECTED_APPROVER,
        APPROVAL_DATE AS APPROVAL_DATE_BY_SELECTED_APPROVER,
        APPROVAL_NOTE AS NOTE2
    FROM APPROVAL_DATA
    WHERE RANK_NO = (SELECT MAX(RANK_NO) FROM APPROVAL_DATA a WHERE a.PO_HEADER_ID = APPROVAL_DATA.PO_HEADER_ID)
),

PREVIOUS_APPROVER AS (
    SELECT
        PO_HEADER_ID,
        APPROVER AS PREVIOUS_APPROVER,
        APPROVAL_DATE AS APPROVAL_DATE_BY_PREVIOUS_APPROVER,
        APPROVAL_NOTE AS NOTE1
    FROM APPROVAL_DATA
    WHERE RANK_NO = (
        SELECT MAX(RANK_NO)-1
        FROM APPROVAL_DATA a
        WHERE a.PO_HEADER_ID = APPROVAL_DATA.PO_HEADER_ID
    )
)

SELECT
    FAB.FLEX_VALUE AS COMPANY_CODE,
    FAB.BU_NAME AS PO_COMPANY_NAME,
    PHV.SEGMENT1 AS PO_NUMBER,
    PHV.DOCUMENT_STATUS AS PO_HEADER_STATUS,
    PSV.VENDOR_NAME,
    PSV.VENDOR_NUMBER,
    PHV.CREATED_BY AS PO_CREATED_BY,
    TO_CHAR(PHV.CREATION_DATE,'DD.MM.YYYY') AS PO_CREATION_DATE,
    TO_CHAR(PHV.SUBMIT_DATE,'DD.MM.YYYY') AS SUBMIT_DATE,
    PHV.CURRENCY_CODE,
    PHV.TOTAL_AMOUNT AS PO_AMOUNT,
    PHV.AMOUNT_USD AS PO_USD_AMOUNT,

    PA.PREVIOUS_APPROVER,
    TO_CHAR(PA.APPROVAL_DATE_BY_PREVIOUS_APPROVER,'DD.MM.YYYY') AS APPROVAL_DATE_BY_PREVIOUS_APPROVER,
    PA.NOTE1,

    SA.SELECTED_APPROVER,
    TO_CHAR(SA.APPROVAL_DATE_BY_SELECTED_APPROVER,'DD.MM.YYYY') AS APPROVAL_DATE_BY_SELECTED_APPROVER,
    SA.NOTE2,

    (TRUNC(SA.APPROVAL_DATE_BY_SELECTED_APPROVER) - TRUNC(PA.APPROVAL_DATE_BY_PREVIOUS_APPROVER)) AS TOTAL_DAYS_TAKEN_BY_SELECTED_APPROVER,
    (TRUNC(SYSDATE) - TRUNC(PA.APPROVAL_DATE_BY_PREVIOUS_APPROVER)) AS TOTAL_DAYS_PENDING_FROM_PREVIOUS_APPROVER,
    (TRUNC(SYSDATE) - TRUNC(PHV.SUBMIT_DATE)) AS TOTAL_DAYS_PENDING_FROM_SUBMISSION

FROM
    PO_HEADERS_V PHV
    LEFT JOIN POS_SUPPLIERS_V PSV ON PSV.VENDOR_ID = PHV.VENDOR_ID
    LEFT JOIN FUN_ALL_BUSINESS_UNITS_V FAB ON FAB.BU_ID = PHV.PRC_BU_ID
    LEFT JOIN SELECTED_APPROVER SA ON SA.PO_HEADER_ID = PHV.PO_HEADER_ID
    LEFT JOIN PREVIOUS_APPROVER PA ON PA.PO_HEADER_ID = PHV.PO_HEADER_ID

WHERE
    TRUNC(PHV.CREATION_DATE) BETWEEN NVL(:P_START_DATE, PHV.CREATION_DATE) AND NVL(:P_END_DATE, PHV.CREATION_DATE)
    AND PHV.DOCUMENT_STATUS = NVL(:P_PO_STATUS, PHV.DOCUMENT_STATUS)
    AND PHV.BU_NAME = NVL(:P_COMPANY_NAME, PHV.BU_NAME)
    AND PSV.VENDOR_NUMBER = NVL(:P_VENDOR_NUMBER, PSV.VENDOR_NUMBER)
    AND PSV.VENDOR_NAME = NVL(:P_VENDOR_NAME, PSV.VENDOR_NAME);
