SELECT

aia.invoice_num,

aia.invoice_currency_code

gl.currency_code

aia.invoice_amount

AS transaction_currency, AS functional_currency, AS transaction_amount,

CASE

WHEN aia.invoice_currency_code = gl.currency_code

THEN 1

ELSE NVL(aia.exchange_rate, gdr.conversion_rate)

END

AS conversion_rate,

ROUND(

aia.invoice_amount *

CASE

THEN 1

WHEN aia.invoice_currency_code = gl.currency_code

ELSE NVL(aia.exchange_rate, gdr.conversion_rate)

END, 2)

AS functional_amount

FROM ap_invoices_all aia

JOIN gl_ledgers gl

ON gl.ledger_id = aia.set_of_books_id

-- adjust to your table's ledger column

LEFT JOIN gl_daily_rates gdr

ON gdr.from_currency aia.invoice_currency_code

AND gdr.to_currency = gl.currency_code
and gdr.conversion_type ='corporate'
and gdr.conversion_date =TRUNC(aia.invoice_date)
