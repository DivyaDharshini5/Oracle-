SELECT
    poh.rcv_transaction_id AS "PO HEADER ID",
    poh.segment1 AS "PO Number",
    poh.currency_code AS "Currency",
    poh.creation_date AS "PO Creation Date",
    bu.name AS "Company Name",
    sup.vendor_name AS "Vendor Name",
    wf.approver_name AS "Selected Approver",
    wf.action_date AS "Approval Date",
    wf.action_type AS "Approval Status",
    wf.comments AS "Note"
FROM
    Fusion.Procurement.POR_HEADERS_RFQ_V poh  -- Replace based on available VO
    LEFT JOIN Fusion.Setup.FUN_ALL_BUSINESS_UNITS_V bu
        ON bu.bu_id = poh.prc_bu_id
    LEFT JOIN Fusion.Supplier.POS_SUPPLIERS_V sup
        ON sup.vendor_id = poh.vendor_id
    LEFT JOIN Fusion.Workflow.FND_WF_APPROVAL_HISTORY_V wf
        ON wf.document_id = poh.po_header_id
WHERE
    poh.creation_date >= :P_START_DATE
    AND poh.creation_date <= :P_END_DATE
