SELECT DISTINCT
    CASE 
        WHEN poapp_15_approved_dt IS NOT NULL THEN poapp_15_approved_by
        WHEN poapp_13_approved_dt IS NOT NULL THEN poapp_13_approved_by
        WHEN poapp_11_approved_dt IS NOT NULL THEN poapp_11_approved_by
        ELSE NULL
    END AS selected_approver
FROM PO_APPROVAL
WHERE (poapp_15_approved_dt IS NOT NULL
    OR poapp_13_approved_dt IS NOT NULL
    OR poapp_11_approved_dt IS NOT NULL)
ORDER BY selected_approver;
