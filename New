SELECT
    -- Selected Approver
    COALESCE(
        MAX(CASE WHEN po_app.rn=5 THEN po_app.approver END),
        MAX(CASE WHEN po_app.rn=4 THEN po_app.approver END),
        MAX(CASE WHEN po_app.rn=3 THEN po_app.approver END),
        MAX(CASE WHEN po_app.rn=2 THEN po_app.approver END),
        MAX(CASE WHEN po_app.rn=1 THEN po_app.approver END)
    ) AS Selected_Approver,

    fab.bu_id AS Company_Code,
    fab.bu_name AS PO_Company_Name,
    poh.segment1 AS PO_Number,
    poh.document_status AS PO_Header_Status,
    hp.party_name AS Vendor_Name,
    pos.segment1 AS Vendor_Number,
    poh.created_by AS PO_Created_By,
    TO_CHAR(poh.creation_date,'DD.MM.YYYY') AS PO_Creation_Date,
    TO_CHAR(poh.submit_date,'DD.MM.YYYY') AS Submit_Date,
    poh.currency_code AS Currency_Code,

    -- PO Amounts
    pol_tot.po_amount AS PO_Amount,
    pol_tot.po_usd_amount AS PO_USD_Amount,

    -- Previous Approver
    COALESCE(
        MAX(CASE WHEN po_app.rn=4 THEN po_app.approver END),
        MAX(CASE WHEN po_app.rn=3 THEN po_app.approver END),
        MAX(CASE WHEN po_app.rn=2 THEN po_app.approver END)
    ) AS Previous_Approver,

    COALESCE(
        MAX(CASE WHEN po_app.rn=4 THEN po_app.approved_dt END),
        MAX(CASE WHEN po_app.rn=3 THEN po_app.approved_dt END),
        MAX(CASE WHEN po_app.rn=2 THEN po_app.approved_dt END)
    ) AS Approval_Date_by_Previous_Approver,

    MAX(CASE WHEN po_app.rn=1 THEN po_app.note END) AS Note1,
    MAX(CASE WHEN po_app.rn=2 THEN po_app.note END) AS Note2,

    -- Approval Date by Selected Approver
    COALESCE(
        MAX(CASE WHEN po_app.rn=5 THEN po_app.approved_dt END),
        MAX(CASE WHEN po_app.rn=4 THEN po_app.approved_dt END),
        MAX(CASE WHEN po_app.rn=3 THEN po_app.approved_dt END),
        MAX(CASE WHEN po_app.rn=2 THEN po_app.approved_dt END),
        MAX(CASE WHEN po_app.rn=1 THEN po_app.approved_dt END)
    ) AS Approval_Date_by_Selected_Approver,

    -- Days calculations
    COALESCE(
        MAX(CASE WHEN po_app.rn=5 THEN po_app.approved_dt END),
        MAX(CASE WHEN po_app.rn=4 THEN po_app.approved_dt END),
        MAX(CASE WHEN po_app.rn=3 THEN po_app.approved_dt END),
        MAX(CASE WHEN po_app.rn=2 THEN po_app.approved_dt END),
        MAX(CASE WHEN po_app.rn=1 THEN po_app.approved_dt END)
    ) -
    COALESCE(
        MAX(CASE WHEN po_app.rn=4 THEN po_app.approved_dt END),
        MAX(CASE WHEN po_app.rn=3 THEN po_app.approved_dt END),
        MAX(CASE WHEN po_app.rn=2 THEN po_app.approved_dt END),
        MAX(CASE WHEN po_app.rn=1 THEN po_app.approved_dt END)
    ) AS Total_Days_Pending_from_Previous_Approver,

    COALESCE(
        MAX(CASE WHEN po_app.rn=5 THEN po_app.approved_dt END),
        MAX(CASE WHEN po_app.rn=4 THEN po_app.approved_dt END),
        MAX(CASE WHEN po_app.rn=3 THEN po_app.approved_dt END),
        MAX(CASE WHEN po_app.rn=2 THEN po_app.approved_dt END),
        MAX(CASE WHEN po_app.rn=1 THEN po_app.approved_dt END)
    ) - TRUNC(poh.submit_date) AS Total_Days_Taken_by_Selected_Approver,

    (TRUNC(SYSDATE)-TRUNC(poh.submit_date))+1 AS Total_Days_Pending_from_Submission

FROM po_headers_all poh
LEFT JOIN po_lines_all pol ON pol.po_header_id=poh.po_header_id
LEFT JOIN (
    SELECT po_header_id,
           SUM(ROUND(unit_price*quantity,2)) AS po_amount,
           SUM(ROUND(unit_price*quantity*NVL((SELECT rat.conversion_rate
                                              FROM gl_daily_rates rat
                                              WHERE rat.from_currency=pl.currency_code
                                                AND rat.to_currency='USD'
                                                AND rat.conversion_type='Corporate'
                                                AND rat.conversion_date=TRUNC(pl.creation_date)),1),2)) AS po_usd_amount
    FROM po_lines_all pl
    GROUP BY po_header_id
) pol_tot ON pol_tot.po_header_id=poh.po_header_id
LEFT JOIN ap_suppliers pos ON pos.vendor_id=poh.vendor_id
LEFT JOIN hz_parties hp ON hp.party_id=pos.party_id
LEFT JOIN fun_all_business_units_v fab ON fab.bu_id=poh.prcbuid
LEFT JOIN (
    SELECT pha.po_header_id, pha.prcbuid, pha.segment1,
           pnfv.display_name AS approver,
           REPLACE(REPLACE(REPLACE(RTRIM(PATC.user_comment),CHR(9),''),CHR(10),''),'','') AS note,
           pah.action_date AS approved_dt,
           ROW_NUMBER() OVER(PARTITION BY pha.po_header_id ORDER BY pha.po_header_id, pah.sequence_num) AS rn
    FROM po_action_history pah
    JOIN po_headers_all pha ON pha.po_header_id=pah.object_id
    LEFT JOIN por_approval_task_comments PATC ON PATC.object_id=pah.object_id AND PATC.performer_id=pah.performer_id AND PATC.identification_key=pah.identification_key
    LEFT JOIN per_person_names fv pnfv ON pah.performer_id=pnfv.person_id
    JOIN fun_all_business_units_v fab2 ON fab2.bu_id=pha.prcbuid
    WHERE pah.action_code='APPROVE'
      AND pha.document_status NOT IN ('WITHDRAWN','PENDING APPROVAL')
) po_app ON po_app.po_header_id=poh.po_header_id

WHERE poh.document_status NOT IN ('CANCELED','INCOMPLETE')
  AND TRUNC(poh.creation_date) BETWEEN :START_DATE_PO AND :END_DATE_PO
  AND fab.bu_name=NVL(:P_COMPANY_NAME,fab.bu_name)

GROUP BY poh.po_header_id, fab.bu_id, fab.bu_name, poh.segment1, poh.document_status, hp.party_name, pos.segment1, poh.created_by, poh.creation_date, poh.submit_date, poh.currency_code
ORDER BY poh.segment1;
