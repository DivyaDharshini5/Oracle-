SELECT DISTINCT
  COALESCE(
    poapp.L5_APPROVED_BY,
    poapp.L4_APPROVED_BY,
    poapp.L3_APPROVED_BY,
    poapp.L2_APPROVED_BY,
    poapp.L1_APPROVED_BY
  ) AS SELECTED_APPROVER
FROM
  PO_HEADERS_ALL POH,
  PO_LINES_ALL POL,
  PO_SUPPLIERS_V POS,
  HZ_PARTIES HP,
  PO_DISTRIBUTIONS_ALL POD,
  GL_CODE_COMBINATIONS GCC,
  FND_BUSINESS_UNITS_V FAB,
  PER_PERSON_NAMES_F_V PPNFV,
  PO_APPROVAL POAPP,
  PO_REJECT POREJ,
  PO_PENDING POPEN
WHERE 1=1
  -- your existing join conditions
  AND POL.PO_HEADER_ID = POH.PO_HEADER_ID
  AND POS.VENDOR_ID = POH.VENDOR_ID
  AND HP.PARTY_ID = POS.PARTY_ID
  AND POD.PO_HEADER_ID = POH.PO_HEADER_ID
  AND GCC.CODE_COMBINATION_ID = POD.CODE_COMBINATION_ID
  AND FAB.BUSINESS_UNIT_ID = POH.BUSINESS_UNIT_ID
  AND PPNFV.PERSON_ID = POAPP.APPROVER_ID(+)
  AND POAPP.PO_HEADER_ID(+) = POH.PO_HEADER_ID
  AND POAPP.PRC_BU_ID(+) = POH.PRC_BU_ID
  AND POAPP.SEGMENT1(+) = POH.SEGMENT1
  AND POREJ.PO_HEADER_ID(+) = POH.PO_HEADER_ID
  AND POREJ.PRC_BU_ID(+) = POH.PRC_BU_ID
  AND POREJ.SEGMENT1(+) = POH.SEGMENT1
  AND POPEN.PO_HEADER_ID(+) = POH.PO_HEADER_ID
  AND POPEN.PRC_BU_ID(+) = POH.PRC_BU_ID
  AND POPEN.SEGMENT1(+) = POH.SEGMENT1
  -- only non-null approvers
  AND COALESCE(
        poapp.L5_APPROVED_BY,
        poapp.L4_APPROVED_BY,
        poapp.L3_APPROVED_BY,
        poapp.L2_APPROVED_BY,
        poapp.L1_APPROVED_BY
      ) IS NOT NULL
ORDER BY SELECTED_APPROVER;
